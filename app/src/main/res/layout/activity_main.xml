<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/focus_background"
    android:orientation="vertical"
    android:padding="37dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="55dp"
        android:layout_weight="1"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:layout_marginTop="180dp"
        android:layout_marginBottom="40dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textTituloFocus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="FOCUS"
            android:textColor="@color/focus_primary"
            android:textSize="80dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTituloFlow"
            android:layout_width="wrap_content"
            android:layout_height="78dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-8dp"
            android:text="Flow"
            android:textColor="@color/focus_primary"
            android:textSize="50dp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/textEslogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="Un paso a la vez."
            android:textColor="#49454F"
            android:textSize="16sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIngresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:padding="16dp"
        android:backgroundTint="@android:color/white"
        android:text="Ingresar Con Google"
        android:textColor="@color/focus_primary"
        app:cornerRadius="30dp"
        app:strokeColor="#DDDDDD"
        app:strokeWidth="1dp" />

</LinearLayout>