<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/imagen_front">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Saludo -->
        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Hola! 👋"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/focus_on_background"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoy es un buen día para enfocarte"
            android:textSize="14sp"
            android:textColor="@color/focus_on_secondary_text"
            android:layout_marginBottom="20dp"/>

        <!-- Card estado de ánimo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/focus_surface"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/nav_perfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <!-- Foto de Perfil -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPerfil"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    android:src="@drawable/ic_launcher_background"
                    android:layout_marginEnd="16dp"/>

                <!-- Texto de Bienvenida -->
                <TextView
                    android:id="@+id/tvNombreUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/focus_on_background"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card tarea activa -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTareaActiva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#97E3F0"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/cuadroTareaInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AHORA MISMO"
                    android:textSize="11sp"
                    android:textColor="@color/focus_on_secondary_text"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvTareaActiva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin tarea activa"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/focus_on_background"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvTareaActivaHora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="14sp"
                    android:textColor="@color/focus_primary"
                    android:textStyle="bold"/>



            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card frase motivacional -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFDF85"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 Frase del día"
                    android:textSize="14sp"
                    android:textColor="@color/focus_on_background"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvFrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando frase motivacional..."
                    android:textSize="15sp"
                    android:textColor="@color/focus_on_secondary_text"
                    android:gravity="center"
                    android:fontFamily="sans-serif-light"
                    android:textStyle="italic"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card clima -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardClima"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/focus_surface"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/layoutClima"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvClimaIcono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️"
                    android:textSize="36sp"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvClimaTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando clima..."
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/focus_on_background"/>

                    <TextView
                        android:id="@+id/tvClimaSugerencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculando mejor hora de estudio"
                        android:textSize="13sp"
                        android:textColor="@color/focus_on_secondary_text"/>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>